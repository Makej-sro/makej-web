# Samostatná stránka /cenik zrušena — ceník je v sekci na /pro-zamestnavatele.
# 301, ať odkazy zvenčí a výsledky z vyhledávání nekončí na 404.
/cenik    /pro-zamestnavatele#pricing    301

# Appka a dashboard se přestěhovaly na vlastní doménu (repo makej-app).
# Stěhovalo se nadvakrát: nejdřív tu zůstala záložní kopie `employer/`
# a `worker/`, a protože jsou tahle pravidla bez „!", Netlify je obsluhoval
# ze souborů a nepřesměrovával. Po ověření app.makej.eu se složky smazaly
# a tím se přesměrování zaplo samo — tady se nemuselo sáhnout na nic.
#
# Vykřičník tu pořád není schválně: 301 má platit jen tam, kde soubor není,
# ať se nedá omylem přebít něco, co na makej.eu opravdu leží.
/employer/*   https://app.makej.eu/employer/:splat   301
/worker/*     https://app.makej.eu/worker/:splat     301
